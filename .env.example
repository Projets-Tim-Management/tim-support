# WordPress headless backend du site support
SUPPORT_WP_API_URL=https://support-tim-management.co/wp-json/wp/v2

# Clé secrète partagée avec app.tim-management.co pour valider les JWT
# Doit être identique côté app (Mathieu)
JWT_SECRET=your-secret-key-here

# URL de l'app (pour la redirection si non authentifié)
NEXT_PUBLIC_APP_URL=https://app.tim-management.co
NEXT_PUBLIC_SITE_URL=https://support.tim-management.co

# Secret partagé serveur-à-serveur entre Next et WordPress pour les routes
# partenaires (points / récompenses). Doit être IDENTIQUE à la constante
# TIM_INTERNAL_SECRET définie dans wp-config.php côté WordPress.
# Générer une valeur aléatoire longue (ex : openssl rand -hex 32).
TIM_INTERNAL_SECRET=your-shared-internal-secret-here

# DEV UNIQUEMENT — prévisualisation de l'espace partenaires sans login.
# Si défini (et hors production), getSession() simule un partenaire connecté
# avec cet email. Laisser VIDE/commenté en production. Pour tester avec de
# vrais points, mettez ici un email auquel vous avez attribué des points en
# back-office WordPress.
# PARTNER_DEV_EMAIL=test@partenaire.fr
# PARTNER_DEV_NAME=Aperçu dev

# ─────────────────────────────────────────────────────────────────────────────
# Payload CMS (migration back sur-mesure)
# ─────────────────────────────────────────────────────────────────────────────

# Secret de signature Payload. Générer : openssl rand -hex 32
PAYLOAD_SECRET=your-payload-secret-here

# Connexion Postgres (Supabase). En dev + migrations : session pooler (port 5432).
# En prod (Vercel) : transaction pooler (port 6543, ?pgbouncer=true).
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
